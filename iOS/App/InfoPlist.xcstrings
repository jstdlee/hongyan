    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hongyan backs up your photos and videos to your own S3-compatible storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸿雁会把你的照片和视频备份到你自己的 S3 兼容存储。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鴻雁は写真とビデオを自分の S3 互換ストレージにバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hongyan은 사진과 비디오를 사용자의 S3 호환 스토리지에 백업합니다."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hongyan can use coarse location to stay awake during a backup, if you turn this on in Settings. Your location is not stored or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在设置中开启，鸿雁可在备份期间使用大致位置保持唤醒。你的位置不会被保存或上传。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でオンにすると、鴻雁はバックアップ中に起動を維持するため、おおよその位置情報を使います。位置情報は保存もアップロードもしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 켜면 Hongyan은 백업 중에 깨어 있기 위해 대략적인 위치를 사용합니다. 위치는 저장하거나 업로드하지 않습니다."
          }
        }
      }
    }
  }
}